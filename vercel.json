{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)",    "destination": "/api/$1" },
    { "source": "/discover",    "destination": "/listing.html" },
    { "source": "/methodology", "destination": "/about.html" },
    { "source": "/creator",     "destination": "/creator.html" },
    { "source": "/restaurant-partner", "destination": "/restaurant_partner.html" },
    { "source": "/faq",         "destination": "/faq.html" },
    { "source": "/contact",     "destination": "/contact.html" },
    { "source": "/legal",       "destination": "/legal.html" },
    { "source": "/about",       "destination": "/about.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
